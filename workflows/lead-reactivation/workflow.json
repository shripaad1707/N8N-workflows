        "emailFormat": "html",
        "html": "=<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;background:#f5f7fa;padding:40px;\">\n  \n  <div style=\"max-width:620px;margin:0 auto;background:#ffffff;border-radius:14px;overflow:hidden;box-shadow:0 10px 30px rgba(0,0,0,0.08);\">\n\n    <!-- Header -->\n    <div style=\"background:#0b0b0c;padding:22px 30px;color:#fff;\">\n      <h2 style=\"margin:0;font-weight:600;letter-spacing:0.5px;\">Aether</h2>\n      <p style=\"margin:5px 0 0;font-size:13px;color:#bbb;\">Lead Reactivation System</p>\n    </div>\n\n    <!-- Body -->\n    <div style=\"padding:32px;\">\n      \n      <h3 style=\"margin-top:0;color:#111;\">Hi {{ $json.fields.Name }},</h3>\n\n      <p style=\"color:#444;line-height:1.6;\">\n        We noticed your earlier interest and wanted to quickly follow up with you.\n      </p>\n\n      <p style=\"color:#444;line-height:1.6;\">\n        Our system helps businesses automate lead responses, follow-ups, and improve conversion rates without missing any potential customers.\n      </p>\n\n      <!-- Highlight -->\n      <div style=\"background:#f1f3f5;padding:15px;border-radius:10px;margin:20px 0;\">\n        <p style=\"margin:0;color:#333;\">\n          🚀 <strong>Status:</strong> Your request is being actively followed up\n        </p>\n      </div>\n\n      <p style=\"color:#444;line-height:1.6;\">\n        Just wanted to check — are you still interested in continuing?\n      </p>\n\n      <!-- CTA -->\n      <div style=\"text-align:center;margin:30px 0;\">\n        <a href=\"#\" style=\"background:#111;color:#fff;padding:12px 26px;border-radius:8px;text-decoration:none;font-weight:500;\">\n          Reply to Continue\n        </a>\n      </div>\n\n      <p style=\"color:#888;font-size:13px;\">\n        If this wasn’t intended for you, you can safely ignore this email.\n      </p>\n\n    </div>\n\n    <!-- Footer -->\n    <div style=\"background:#fafafa;padding:18px;text-align:center;font-size:12px;color:#999;\">\n      © 2026 Aether. All rights reserved.\n    </div>\n\n  </div>\n</div>",
        "options": {}
