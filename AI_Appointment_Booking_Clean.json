      "parameters": {
        "jsCode": "const item = $('Webhook Trigger').item.json.body;\n\nconst htmlEmail = `\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Appointment Confirmation</title>\n  <style>\n    body { margin: 0; padding: 0; background-color: #f4f6f9; font-family: 'Segoe UI', Arial, sans-serif; }\n    .wrapper { width: 100%; background-color: #f4f6f9; padding: 40px 20px; box-sizing: border-box; }\n    .container { max-width: 600px; margin: 0 auto; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 24px rgba(0,0,0,0.08); }\n    .header { background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); padding: 40px 30px; text-align: center; }\n    .header h1 { color: #ffffff; margin: 0; font-size: 28px; font-weight: 700; letter-spacing: -0.5px; }\n    .header p { color: #bfdbfe; margin: 8px 0 0; font-size: 15px; }\n    .checkmark { font-size: 48px; margin-bottom: 12px; display: block; }\n    .body { padding: 36px 32px; }\n    .greeting { font-size: 17px; color: #1e293b; margin-bottom: 8px; font-weight: 600; }\n    .message { font-size: 15px; color: #475569; line-height: 1.7; margin-bottom: 28px; }\n    .details-card { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 24px; margin-bottom: 28px; }\n    .details-card h3 { margin: 0 0 16px; font-size: 14px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 1px; }\n    .detail-row { display: flex; align-items: flex-start; padding: 10px 0; border-bottom: 1px solid #e2e8f0; }\n    .detail-row:last-child { border-bottom: none; padding-bottom: 0; }\n    .detail-icon { width: 32px; height: 32px; border-radius: 8px; background: #dbeafe; display: flex; align-items: center; justify-content: center; margin-right: 14px; font-size: 14px; flex-shrink: 0; }\n    .detail-label { font-size: 12px; color: #94a3b8; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 2px; }\n    .detail-value { font-size: 15px; color: #1e293b; font-weight: 500; }\n    .cta-section { text-align: center; margin-bottom: 28px; }\n    .footer { background: #f8fafc; padding: 24px 32px; border-top: 1px solid #e2e8f0; text-align: center; }\n    .footer p { margin: 0 0 8px; font-size: 13px; color: #94a3b8; line-height: 1.6; }\n    .footer a { color: #2563eb; text-decoration: none; font-weight: 500; }\n  </style>\n</head>\n<body>\n  <div class=\"wrapper\">\n    <div class=\"container\">\n      <div class=\"header\">\n        <span class=\"checkmark\">✅</span>\n        <h1>Appointment Confirmation</h1>\n        <p>Your booking has been successfully received</p>\n      </div>\n      <div class=\"body\">\n        <p class=\"greeting\">Dear ${item.name},</p>\n        <p class=\"message\">\n          Your appointment for <strong>${item.service}</strong> has been successfully scheduled. \n          We look forward to seeing you! Please find your appointment details below.\n        </p>\n        <div class=\"details-card\">\n          <h3>📋 Appointment Details</h3>\n          <div class=\"detail-row\">\n            <div class=\"detail-icon\">🛠️</div>\n            <div>\n              <div class=\"detail-label\">Service</div>\n              <div class=\"detail-value\">${item.service}</div>\n            </div>\n          </div>\n          <div class=\"detail-row\">\n            <div class=\"detail-icon\">📅</div>\n            <div>\n              <div class=\"detail-label\">Date</div>\n              <div class=\"detail-value\">${item.date}</div>\n            </div>\n          </div>\n          <div class=\"detail-row\">\n            <div class=\"detail-icon\">⏰</div>\n            <div>\n              <div class=\"detail-label\">Time</div>\n              <div class=\"detail-value\">${item.time}</div>\n            </div>\n          </div>\n          <div class=\"detail-row\">\n            <div class=\"detail-icon\">📞</div>\n            <div>\n              <div class=\"detail-label\">Phone</div>\n              <div class=\"detail-value\">${item.phone}</div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <div class=\"footer\">\n        <p>Need to reschedule or have questions?</p>\n        <p>Feel free to <a href=\"mailto:support@yourdomain.com\">contact us</a> and we'll be happy to assist you.</p>\n        <p style=\"margin-top: 16px; font-size: 12px; color: #cbd5e1;\">© 2025 Your Business Name · All rights reserved</p>\n      </div>\n    </div>\n  </div>\n</body>\n</html>\n`;\n\nreturn {\n  htmlEmail,\n  name: item.name,\n  email: item.email,\n  phone: item.phone,\n  service: item.service,\n  date: item.date,\n  time: item.time,\n  message: item.message\n};"
      },
